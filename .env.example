# Server startup only. Run `node scripts/pnpm.mjs setup` to generate .env.local.
# Configure Google, SMTP/Resend and other providers in Administration > Integrations.
DATABASE_URL=
BETTER_AUTH_SECRET=
APP_URL=http://127.0.0.1:3000
INTEGRATION_ENCRYPTION_KEY=
# Setup generates both secrets. Preserve them when restarting or updating.
# Mailpit works automatically; external calls stay off by default.
# Advanced operator controls: docs/local-development.md#server-configuration
