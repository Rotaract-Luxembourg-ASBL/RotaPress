# Server configuration. Local setup generates database/auth/encryption secrets.
# First owner email delivery must be configured BEFORE signing in.
# docs/guides/email-setup.md has complete Resend and SMTP examples.
# The selected sender appears read-only in Integrations > Email after restart.
# Credentials remain private; the admin screen shows only their configured status.
DATABASE_URL=
BETTER_AUTH_SECRET=
APP_URL=http://127.0.0.1:3000
INTEGRATION_ENCRYPTION_KEY=
ROTAPRESS_ENVIRONMENT=production
# Choose EMAIL_PROVIDER=resend or smtp, then enable delivery explicitly.
EMAIL_PROVIDER=disabled
EMAIL_REMOTE_DELIVERY_ENABLED=false
EMAIL_FROM_NAME=RotaPress
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Keep this file's real values private. Never put them in NEXT_PUBLIC_* variables.
# Development capture is opt-in: see docs/development/local-development.md.
